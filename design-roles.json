  "effect": {
    "blur-effect": {
      "effects": [
        { "type": "INNER_SHADOW", "color": "#FFFFFFCC", "offset": [1, 1], "radius": 2, "spread": 1 },
        { "type": "DROP_SHADOW", "color": "#FFFFFF", "offset": [-4, -4], "radius": 12, "spread": 0 },
        { "type": "DROP_SHADOW", "color": "#3D405B08", "offset": [4, 4], "radius": 12, "spread": 0 }
      ],
      "css": "box-shadow: -4px -4px 12px 0px #FFFFFF, 4px 4px 12px 0px rgba(61,64,91,0.03), inset 1px 1px 2px 1px rgba(255,255,255,0.8)"
    },
    "gray-shadow": {
      "effects": [
        { "type": "DROP_SHADOW", "color": "#00000012", "offset": [5, 5], "radius": 20, "spread": 0 }
      ],
      "css": "box-shadow: 5px 5px 20px 0px rgba(0,0,0,0.07)",
      "usage": "일반 카드 그레이 그림자"
    },
    "coral-shadow": {
      "effects": [
        { "type": "DROP_SHADOW", "color": "#FFFFFFF2", "offset": [-20, -20], "radius": 40, "spread": 0 },
        { "type": "DROP_SHADOW", "color": "#E07A5F14", "offset": [20, 20], "radius": 40, "spread": 0 }
      ],
      "css": "box-shadow: -20px -20px 40px 0px rgba(255,255,255,0.95), 20px 20px 40px 0px rgba(224,122,95,0.08)",
      "usage": "코랄 계열 카드 그림자 (card-shadow와 동일)"
    }
  },
